# Copy this file to ".env" and fill it in. NEVER upload .env to GitHub.

# Your MongoDB Atlas connection string (with the database name catcafe before the "?")
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/catcafe?retryWrites=true&w=majority

# Optional: use a different database name, so teammates do not share (and overwrite) each other's test data
# MONGODB_DB=catcafe_yourname

PORT=5000

# Any long random text (at least 16 characters). It signs the login tokens. Keep it secret.
JWT_SECRET=change-me-to-a-long-random-text

# How forgot-password codes are delivered while there is no email service:
#   console = the code is printed in the server log (safe when friends use the site)
#   page    = the code is shown on the web page (ONLY if you are the only user)
RESET_CODE_MODE=console

# The cafe's time zone (the server works out "today" and "open now" with it)
CAFE_TIMEZONE=Asia/Singapore

# First start only: the passwords for the staff accounts (admin, aisha, ben). Required when NODE_ENV=production.
# Rules: 8 to 12 characters with an uppercase letter, a lowercase letter, a number and a special character.
# ADMIN_PASSWORD=
# AISHA_PASSWORD=
# BEN_PASSWORD=

# Only while developing the React dashboard on its own address (npm run dev): the address it runs on
# DASHBOARD_ORIGIN=http://localhost:5173

# Optional booking emails with EmailJS (https://www.emailjs.com). Leave these out and no emails are sent. See docs/EMAIL.md.
# EMAILJS_SERVICE_ID=service_xxxxxxx
# EMAILJS_BOOKING_TEMPLATE_ID=template_xxxxxxx
# EMAILJS_PAYMENT_TEMPLATE_ID=template_xxxxxxx
# EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
# EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxx
